# Copy to .env and enter credentials locally. Never commit .env.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Export and dbt must point to the same dedicated database.
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/job_market
PGHOST=localhost
PGUSER=YOUR_USER
PGPASSWORD=YOUR_PASSWORD
PGDATABASE=job_market
